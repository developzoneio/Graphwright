# Graphwright — root .editorconfig
# Encodes the tooling-enforceable C# conventions from CLAUDE.md "C# coding conventions".
# NOT expressible here (recorded as house rules in CLAUDE.md): `== false` / `== true`
# negation, `Async` suffix on async methods. Enforced by review, not by tooling.

root = true

###############################
# All files
###############################
[*]
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

###############################
# C# source files
###############################
[*.cs]
indent_style = space
indent_size = 4
tab_width = 4
end_of_line = crlf
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

# 120-column guidance
guidelines = 120
max_line_length = 120

#----------------------------------------------------------------------
# Roslyn naming rules
#----------------------------------------------------------------------

# Symbol groups
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.private_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_internal_fields.applicable_accessibilities = private, internal, private_protected

dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.applicable_accessibilities = *
dotnet_naming_symbols.constant_fields.required_modifiers = const

dotnet_naming_symbols.public_members.applicable_kinds = method, property, event
dotnet_naming_symbols.public_members.applicable_accessibilities = public

# Naming styles
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_style.all_upper_case.word_separator = _
dotnet_naming_style.all_upper_case.capitalization = all_upper

dotnet_naming_style.pascal_case.capitalization = pascal_case

# Rules
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_begin_with_i.severity = error

# Constants must precede the private/internal field rule: a const field also matches
# the field rule, and Roslyn applies the first matching rule.
dotnet_naming_rule.constants_all_upper.symbols = constant_fields
dotnet_naming_rule.constants_all_upper.style = all_upper_case
dotnet_naming_rule.constants_all_upper.severity = error

dotnet_naming_rule.private_internal_fields_underscore.symbols = private_internal_fields
dotnet_naming_rule.private_internal_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_internal_fields_underscore.severity = error

dotnet_naming_rule.public_members_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_pascal_case.style = pascal_case
dotnet_naming_rule.public_members_pascal_case.severity = error

# CA1707 ("remove underscores from externally visible member names") conflicts with
# constants_all_upper above (ALL_UPPER requires underscore-separated words on public constants).
# The repo's naming rules are the codified standard and win over CA1707.
dotnet_diagnostic.CA1707.severity = none

###############################
# XML / MSBuild project files
###############################
[*.{xml,csproj,props,targets}]
indent_style = space
indent_size = 2

###############################
# JSON / YAML
###############################
[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
