# packages.lock.json

# MSBuild Binary and Source Logs
*.binlog
*.sarif

# .NET publish output
publish/
PublishProfiles/

# Test results and coverage
TestResults/
[Cc]overage*/
*.coverage
*.coveragexml
coverage.json
coverage.cobertura.xml

# .NET secrets (never commit)
secrets.json
appsettings.*.json
!appsettings.json
!appsettings.Development.json.example

